{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "color": {
      "keys": "38;2;226;52;42",
      "title": "#ebeff0"
    },
    "key": {
      "width": 7
    },
    "separator": "·"
  },
  "modules": [
    {
      "format": "\u001b[38;2;226;52;42m■\u001b[0m \u001b[38;2;143;135;112m{#1;title}MINIMAL GRID{#}\u001b[0m",
      "type": "custom"
    },
    {
      "key": "os",
      "type": "os"
    },
    {
      "key": "kernel",
      "type": "kernel"
    },
    {
      "key": "cpu",
      "type": "cpu"
    },
    {
      "key": "memory",
      "percent": {
        "type": 9
      },
      "type": "memory"
    },
    {
      "folders": "/",
      "key": "disk",
      "percent": {
        "type": 9
      },
      "type": "disk"
    },
    {
      "key": "uptime",
      "type": "uptime"
    },
    {
      "type": "colors",
      "symbol": "diamond",
      "paddingLeft": 1
    }
  ]
}
